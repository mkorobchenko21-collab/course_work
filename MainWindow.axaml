<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FlashcardsApp.Models"
        x:Class="FlashcardsApp.MainWindow"
        Title="Flashcards App - Senior Developer Edition" Width="1000" Height="700">

    <Window.Styles>
        <Style Selector="TextBlock.DisplayOnly">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="Button.DisplayOnly">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="TextBox.EditOnly">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Button.EditOnly">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid ColumnDefinitions="250, *">

            <!-- Left: Library Management (Sidebar) -->
            <Border Grid.Column="0" Background="#F4F4F4" BorderBrush="#DDD" BorderThickness="0,0,1,0" Padding="15">
                <DockPanel>
                    <Button Content="Save and Exit" Click="Quit_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,15" DockPanel.Dock="Top"/>
                    <TextBox x:Name="SearchTextBox" PlaceholderText="Search decks..." TextChanged="SearchTextBox_TextChanged" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    <TextBlock Text="LIBRARY" FontWeight="ExtraBold" FontSize="14" Foreground="#777" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    
                    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,15,0,0">
                        <TextBox x:Name="NewItemNameInput" PlaceholderText="New item name..."/>
                        <Button Content="Add Folder" HorizontalAlignment="Stretch" Click="AddFolder_Click" Background="#3498DB" Foreground="White"/>
                        <Button Content="Add Deck" HorizontalAlignment="Stretch" Click="AddDeck_Click" Background="#3498DB" Foreground="White"/>
                        <Button Content="Delete Selected" HorizontalAlignment="Stretch" Click="DeleteSelected_Click" Background="#95A5A6" Foreground="White"/>
                        <Button Content="Save Library" HorizontalAlignment="Stretch" Click="SaveLibrary_Click" Background="#2ECC71" Foreground="White" Margin="0,10,0,0"/>
                    </StackPanel>

                    <TreeView x:Name="LibraryTreeView" SelectionChanged="LibraryTreeView_SelectionChanged">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate x:DataType="models:Folder" ItemsSource="{Binding Decks}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="📁" />
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                </StackPanel>
                            </TreeDataTemplate>
                            <DataTemplate x:DataType="models:Deck">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="🎴" />
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Right: Content Area -->
            <Grid Grid.Column="1" Margin="25">

                <!-- Panel 0: Welcome -->
                <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="25">
                    <TextBlock Text="Welcome to Flashcards App" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a deck from the sidebar to start learning" FontSize="16" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <StackPanel x:Name="RecentDecksContainer" Spacing="15" Margin="0,20,0,0">
                        <TextBlock Text="RECENT DECKS" FontWeight="Bold" FontSize="12" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                        <ListBox x:Name="RecentDecksListBox" Width="250" Height="200" SelectionChanged="RecentDecksListBox_SelectionChanged" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Deck">
                                    <Border Background="White" CornerRadius="5" Padding="10" Margin="0,2,0,2" BorderBrush="#EEE" BorderThickness="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>

                <!-- Panel 1: DeckMenuPanel (Main Dashboard) -->
                <Grid x:Name="DeckPanel" IsVisible="False" RowDefinitions="Auto, Auto, *">
                    <!-- 1. TOP AREA (3 Mode Buttons) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, *, *" Margin="0,0,0,25">
                        <Button Grid.Column="0" Content="Study Mode" Click="StartStudy_Click" VerticalContentAlignment="Center" Background="#27AE60" Foreground="White" Height="50" Margin="0,0,5,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="Quiz Mode" Click="StartQuiz_Click" VerticalContentAlignment="Center" Background="#2980B9" Foreground="White" Height="50" Margin="5,0,5,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold"/>
                        <Button Grid.Column="2" Content="Edit Mode" Click="StartEdit_Click" VerticalContentAlignment="Center" Background="#F39C12" Foreground="White" Height="50" Margin="5,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold"/>
                    </Grid>

                    <!-- 2. MIDDLE AREA (Card Preview Carousel) -->
                    <Border Grid.Row="1" Background="#ECF0F1" CornerRadius="12" BorderBrush="#BDC3C7" BorderThickness="1" Padding="40">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                            <Button Content="&lt;" Click="CarouselPrev_Click" VerticalAlignment="Center" Width="40" Height="40" CornerRadius="0" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                                <Button x:Name="CarouselCardButton" Click="CarouselFlip_Click" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" Padding="25" Width="350" Height="180" CornerRadius="12">
                                    <TextBlock x:Name="CarouselCardText" Text="Click to flip" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="#2C3E50"/>
                                </Button>
                                <TextBlock x:Name="CarouselCounterText" Text="0 / 0" HorizontalAlignment="Center" Foreground="#95A5A6" FontSize="14"/>
                            </StackPanel>

                            <Button Content="&gt;" Click="CarouselNext_Click" VerticalAlignment="Center" Width="40" Height="40" CornerRadius="0" Background="White" BorderBrush="#BDC3C7" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. BOTTOM AREA (Quick Edit List) -->
                    <Grid Grid.Row="2" RowDefinitions="Auto, *" Margin="0,25,0,0">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                            <TextBlock Text="QUICK EDIT CARDS" FontWeight="Bold" FontSize="12" Foreground="#BDC3C7" VerticalAlignment="Center"/>
                            <Button Content="Shuffle" Click="Shuffle_Click" Margin="15,0,0,0" Background="#9B59B6" Foreground="White" FontSize="10" Padding="10,2" CornerRadius="4"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl x:Name="QuickEditList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Card">
                                        <Border BorderBrush="#ECF0F1" BorderThickness="0,0,0,1" Padding="10">
                                            <Grid ColumnDefinitions="*, *, Auto">
                                                <!-- Display Mode -->
                                                <TextBlock Grid.Column="0" Text="{Binding Term}" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="True" Classes="DisplayOnly"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Definition}" Foreground="#7F8C8D" VerticalAlignment="Center" IsVisible="True" Classes="DisplayOnly"/>
                                                
                                                <!-- Edit Mode -->
                                                <TextBox Grid.Column="0" Text="{Binding Term, Mode=TwoWay}" Margin="0,0,5,0" IsVisible="False" Classes="EditOnly"/>
                                                <TextBox Grid.Column="1" Text="{Binding Definition, Mode=TwoWay}" Margin="5,0,5,0" IsVisible="False" Classes="EditOnly"/>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Edit" Click="ToggleQuickEdit_Click" Classes="DisplayOnly"/>
                                                    <Button Content="✔" Click="SaveQuickEdit_Click" Background="#2ECC71" Foreground="White" IsVisible="False" Classes="EditOnly"/>
                                                    <Button Content="✖" Click="ToggleQuickEdit_Click" Background="#E74C3C" Foreground="White" IsVisible="False" Classes="EditOnly"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Panel 2: Study Mode -->
                <StackPanel x:Name="StudyPanel" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30">
                    <DockPanel LastChildFill="False" Width="450">
                        <Button Content="Back to Deck" Click="BackToDeck_Click" DockPanel.Dock="Left" Background="Transparent" Foreground="#3498DB"/>
                        <TextBlock x:Name="StudyCounterText" Text="0 / 0" VerticalAlignment="Center" DockPanel.Dock="Right" Foreground="#95A5A6"/>
                    </DockPanel>
                    
                    <Button x:Name="StudyCardButton" Click="StudyFlip_Click" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="12" Width="500" Height="300" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="20">
                        <TextBlock x:Name="StudyCardText" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Foreground="#2C3E50"/>
                    </Button>
                    
                    <StackPanel x:Name="SwipeButtons" Orientation="Horizontal" Spacing="25" HorizontalAlignment="Center">
                        <Button Content="Don't Know" Background="#E74C3C" Foreground="White" Width="160" Height="50" Click="SwipeLeft_Click" CornerRadius="8" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="Got It!" Background="#2ECC71" Foreground="White" Width="160" Height="50" Click="SwipeRight_Click" CornerRadius="8" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Panel 3: Study Results -->
                <StackPanel x:Name="StudyResultPanel" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30">
                    <TextBlock Text="Congratulations!" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    <TextBlock Text="You've finished this study session." FontSize="18" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <Border Background="#F9F9F9" CornerRadius="100" Width="200" Height="200" BorderBrush="#27AE60" BorderThickness="5">
                        <TextBlock Text="✔" FontSize="80" Foreground="#27AE60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="15">
                        <Button Content="STUDY AGAIN" Click="StartStudy_Click" HorizontalAlignment="Center" Width="250" Height="50" Background="#27AE60" Foreground="White" FontWeight="Bold" CornerRadius="25" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="BACK TO DASHBOARD" Click="BackToDeck_Click" HorizontalAlignment="Center" Width="250" Height="50" Background="#3498DB" Foreground="White" FontWeight="Bold" CornerRadius="25" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Panel 4: Quiz Mode -->
                <StackPanel x:Name="QuizPanel" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30">
                    <Button Content="Exit Quiz" Click="BackToDeck_Click" HorizontalAlignment="Left" Background="Transparent" Foreground="#3498DB"/>
                    
                    <TextBlock x:Name="QuizQuestionText" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    
                    <StackPanel Spacing="15" Width="400">
                        <TextBlock Text="Your Answer:" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <TextBox x:Name="QuizAnswerInput" Height="45" FontSize="18" PlaceholderText="Type definition here..."/>
                    </StackPanel>
                    
                    <Button x:Name="SubmitAnswerButton" Content="SUBMIT ANSWER" HorizontalAlignment="Center" Click="SubmitQuiz_Click" Width="200" Height="50" Background="#2980B9" Foreground="White" FontWeight="Bold" CornerRadius="25" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    
                    <StackPanel x:Name="QuizFeedbackContainer" IsVisible="False" Spacing="20">
                        <TextBlock x:Name="QuizFeedbackText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center"/>
                        
                        <StackPanel x:Name="CorrectControls" IsVisible="False" HorizontalAlignment="Center">
                            <Button Content="Next card" Click="QuizNext_Click" Width="200" Height="50" Background="#2ECC71" Foreground="White" FontWeight="Bold" CornerRadius="25" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel x:Name="WrongControls" IsVisible="False" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                            <Button Content="rewrite definition" Click="QuizRewrite_Click" Width="180" Height="50" Background="#F39C12" Foreground="White" FontWeight="Bold" CornerRadius="25" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <Button Content="go next card" Click="QuizNext_Click" Width="180" Height="50" Background="#95A5A6" Foreground="White" FontWeight="Bold" CornerRadius="25" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Panel 5: Edit Mode (Full) -->
                <Grid x:Name="EditPanel" IsVisible="False" RowDefinitions="Auto, *, Auto" RowSpacing="20">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Back" Click="BackToDeck_Click" Background="#95A5A6" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <Button Content="Import / Export" Click="ToggleExchangePanel_Click" Background="#3498DB" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="DECK EDITOR" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                        <Button Grid.Column="2" Content="SAVE CHANGES" Click="SaveEditChanges_Click" Background="#2ECC71" Foreground="White" Padding="20,10" FontWeight="Bold" CornerRadius="5"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl x:Name="CardsEditList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Card">
                                    <Border BorderBrush="#EEE" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,5,12" Background="White">
                                        <Grid ColumnDefinitions="*, *, Auto">
                                            <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                                                <TextBlock Text="TERM" FontSize="10" FontWeight="Bold" Foreground="#BDC3C7"/>
                                                <TextBox Text="{Binding Term, Mode=TwoWay}" PlaceholderText="Enter term..." MaxLength="100"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,10,0">
                                                <TextBlock Text="DEFINITION" FontSize="10" FontWeight="Bold" Foreground="#BDC3C7"/>
                                                <TextBox Text="{Binding Definition, Mode=TwoWay}" PlaceholderText="Enter definition..." MaxLength="100"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="🗑" Background="Transparent" Foreground="#E74C3C" FontSize="20" Click="DeleteCardRow_Click" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="+ ADD NEW CARD" Click="AddCardRow_Click" HorizontalAlignment="Center" Width="250" Height="45" Background="#34495E" Foreground="White" FontWeight="Bold" CornerRadius="22" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>

                <!-- Panel 6: Results -->
                <StackPanel x:Name="ResultPanel" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30">
                    <TextBlock Text="Quiz Completed!" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                    <Border Background="#F9F9F9" CornerRadius="100" Width="200" Height="200" BorderBrush="#2ECC71" BorderThickness="5">
                        <TextBlock x:Name="ResultScoreText" Text="100%" FontSize="48" FontWeight="ExtraBold" Foreground="#2ECC71" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="RETURN TO DASHBOARD" Click="BackToDeck_Click" HorizontalAlignment="Center" Width="250" Height="50" Background="#3498DB" Foreground="White" FontWeight="Bold" CornerRadius="25" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Global Error Message -->
                <Border x:Name="ErrorBanner" IsVisible="False" Background="#FADBD8" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="5" Padding="10" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚠️" Foreground="#E74C3C" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ErrorMessageText" Foreground="#C0392B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
