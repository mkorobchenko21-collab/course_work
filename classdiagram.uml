@startuml
skinparam classAttributeIconSize 0

' --- Models ---
class Card {
    + Term : String
    + Definition : String
    + IsLearned : Boolean
    + Card(term: String, definition: String)
}

class Deck {
    + Name : String
    + Cards : List<Card>
    + TotalCards : Int
    + LearnedCards : Int
    + Deck(name: String)
    + AddCard(card: Card) : void
    + RemoveCard(card: Card) : void
    + EditCard(oldCard: Card, newCard: Card) : void
    + Shuffle() : void
}

class Folder {
    + Name : String
    + Decks : List<Deck>
    + Folder(name: String)
    + AddDeck(deck: Deck) : void
    + RemoveDeck(deck: Deck) : void
}

' --- Services ---
interface IStorageManager {
    + SaveLibrary(folders: List<Folder>, standaloneDecks: List<Deck>, destinationPath: String) : void
    + LoadLibrary(sourcePath: String) : Tuple<List<Folder>, List<Deck>>
    + ExportDeck(deck: Deck, destinationPath: String) : void
    + ImportDeck(sourcePath: String) : Deck
    + ParseDeckFromString(rawText: String, termSeparator: String, cardSeparator: String) : Deck
    + FormatDeckToString(deck: Deck, termSeparator: String, cardSeparator: String) : String
}

class StorageManager {
    - _jsonOptions : JsonSerializerOptions
    + SaveLibrary(folders: List<Folder>, standaloneDecks: List<Deck>, destinationPath: String) : void
    + LoadLibrary(sourcePath: String) : Tuple<List<Folder>, List<Deck>>
    + ExportDeck(deck: Deck, destinationPath: String) : void
    + ImportDeck(sourcePath: String) : Deck
    + ParseDeckFromString(rawText: String, termSeparator: String, cardSeparator: String) : Deck
    + FormatDeckToString(deck: Deck, termSeparator: String, cardSeparator: String) : String
}

' --- Logic ---
class StudySession {
    - _currentDeck : Deck
    - _sessionQueueCards : Queue<Card>
    + StudySession(deck: Deck)
    + GetNextCard() : Card?
    + SwipeLeft(card: Card) : void
    + SwipeRight(card: Card) : void
}

class QuizSession {
    - _currentDeck : Deck
    - _correctAnswers : int
    - _totalQuestions : int
    + QuizSession(deck: Deck)
    + GenerateQuiz(shuffle: bool) : void
    + CheckAnswer(card: Card, answer: String) : Boolean
    + CalculateResults() : String
}

' --- UI ---
class MainWindow {
    - _folders : List<Folder>
    - _standaloneDecks : List<Deck>
    - _recentDecks : List<Deck>
    - _storage : IStorageManager
    - _selectedDeck : Deck?
    - _studySession : StudySession?
    - _quizSession : QuizSession?
    - _currentCard : Card?
    - _editCards : ObservableCollection<Card>
    + MainWindow()
    - LoadApplicationData() : void
    - SortLibrary() : void
    - ShowPanel(active: Control) : void
    - RefreshSidebar() : void
    - UpdateDeckInfo() : void
    - SearchTextBox_TextChanged(sender: object, e: TextChangedEventArgs) : void
    - LibraryTreeView_SelectionChanged(sender: object, e: SelectionChangedEventArgs) : void
    - StartStudy_Click(sender: object, e: RoutedEventArgs) : void
    - StartQuiz_Click(sender: object, e: RoutedEventArgs) : void
    - StartEdit_Click(sender: object, e: RoutedEventArgs) : void
    - ToggleExchangePanel_Click(sender: object, e: RoutedEventArgs) : void
}

class ImportExportWindow {
    - _deck : Deck
    - _storage : IStorageManager
    + ImportExportWindow(deck: Deck, storage: IStorageManager)
    - ExportToText_Click(sender: object, e: RoutedEventArgs) : void
    - ImportFromText_Click(sender: object, e: RoutedEventArgs) : void
    - ExportToJson_Click(sender: object, e: RoutedEventArgs) : void
    - ImportFromJson_Click(sender: object, e: RoutedEventArgs) : void
}

' --- Relationships ---
Folder "1" *-- "*" Deck : contains
Deck "1" *-- "*" Card : contains

IStorageManager <|.. StorageManager : implements
IStorageManager ..> Folder : serializes
IStorageManager ..> Deck : serializes

StudySession --> Deck : manages
QuizSession --> Deck : tests

' UI Dependencies
MainWindow --> IStorageManager : uses
MainWindow --> StudySession : creates/uses
MainWindow --> QuizSession : creates/uses
MainWindow --> Deck : displays/manages
MainWindow --> Folder : displays/manages
MainWindow ..> ImportExportWindow : opens

ImportExportWindow --> IStorageManager : uses
ImportExportWindow --> Deck : modifies

@enduml
